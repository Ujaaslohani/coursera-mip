QDRANT_URL=https://your-qdrant-cloud-url
QDRANT_COLLECTION=COURSEERA_ALMAX_MULTIMODAL
QDRANT_API_KEY=your-qdrant-api-key

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
QDRANT_DISTANCE=Cosine
HF_HOME=.cache/huggingface

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://coursera-mip.vercel.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-backend-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
COHERE_API_KEY=your-cohere-api-key
HF_TOKEN_EMBEDDING=your-huggingface-inference-token
HF_TOKEN=your-huggingface-dataset-token
